# Локальный тестовый MCP-сервер из docker-compose.yml.
# Для рабочего сервера укажите полный HTTPS URL.
MCP_URL=http://mcp-server:8000/mcp
MCP_AUTH_TOKEN=
MCP_SERVER_PORT=8000
MCP_TIMEOUT=60
MCP_CLIENT_HTTP_PORT=8086

# Ollama запущена на Docker-хосте.
OLLAMA_HOST_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=ollama
QWEN_MODEL=qwen2.5:7b-instruct-q4_K_M

USE_LLM=1
LOG_LEVEL=INFO
QUERY=

# Необязательно: отдельный токен доступа к browser API mcp-client-http.
# Секрет MCP_AUTH_TOKEN никогда не передаётся в браузер.
WEB_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONVERSATION_TTL=3600
